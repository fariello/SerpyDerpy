{
  "manifest_version": 3,
  "name": "SerpyDerpy",
  "version": "2.0.0",
  "description": "Crash-resumable multi-engine domain search (Google, Bing, DuckDuckGo), polite multi-format page archiving, clean Markdown extraction, and structured metadata sidecars.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "webNavigation",
    "downloads",
    "downloads.ui",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "power",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "dashboard.html",
  "action": {
    "default_title": "SerpyDerpy v2 — Multi-Engine Search & Archiver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
